# E2E test credentials — copy to .env.e2e and fill in real values.
# This file is safe to commit. .env.e2e is git-ignored.
#
# Roles matter — each fixture logs in as a specific role:
#   TEST_TUTOR_*      → INDEPENDENT tutor (own workspace)
#   TEST_HUB_TUTOR_*  → tutor inside a HUB (needed for the "Менеджер хабу" button)
#   TEST_STUDENT_*    → student (needed for /student/achievements)
#   TEST_MANAGER_*    → manager / hub admin

# Independent tutor
TEST_TUTOR_EMAIL=independent-tutor@example.com
TEST_TUTOR_PASSWORD=yourpassword

# Hub tutor (create one via the manager UI first)
TEST_HUB_TUTOR_EMAIL=hub-tutor@example.com
TEST_HUB_TUTOR_PASSWORD=yourpassword

# Student
TEST_STUDENT_EMAIL=student@example.com
TEST_STUDENT_PASSWORD=yourpassword

# Manager
TEST_MANAGER_EMAIL=manager@example.com
TEST_MANAGER_PASSWORD=yourpassword

# Override base URL (default: https://otutorhub.com)
# E2E_BASE_URL=http://localhost:8080
