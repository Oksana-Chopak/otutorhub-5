# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.production and fill in before a native (iOS/Android) build.
# These are BUILD-TIME variables (Vite inlines anything prefixed VITE_).
# NOTE: Supabase URL + anon key may already be embedded in
#       src/integrations/supabase/client.ts. Setting them here too is harmless
#       and is the cleaner practice. The anon (publishable) key is PUBLIC by
#       design — never put the service_role key in any VITE_ variable.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (public)
VITE_SUPABASE_URL="https://kficbcjqcbhqhjimxfed.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci...your-anon-key..."
VITE_SUPABASE_PROJECT_ID="kficbcjqcbhqhjimxfed"

# RevenueCat (public SDK keys — one per platform). Required for in-app purchases.
# Web/Android web builds don't need the iOS key and vice-versa, but set both for
# the native builds so the Pro purchase flow works (store review tests it).
VITE_REVENUECAT_IOS_KEY="appl_xxxxxxxxxxxxxxxxxxxxxxxx"
VITE_REVENUECAT_ANDROID_KEY="goog_xxxxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# NOT build-time — set these as SUPABASE EDGE FUNCTION SECRETS, not here.
# (Supabase Dashboard → Project Settings → Edge Functions → Secrets)
#   SUPABASE_SERVICE_ROLE_KEY   — auto-injected by Supabase; never expose client-side
#   LIQPAY_PUBLIC_KEY           — web subscription payments
#   LIQPAY_PRIVATE_KEY          — web subscription payments (server only)
#   REVENUECAT_WEBHOOK_SECRET   — auth for the revenuecat-webhook function
#   OAUTH_STATE_SECRET          — signs Google Calendar OAuth state (else it falls
#                                 back to the service-role key — set this!)
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY — web push
# ─────────────────────────────────────────────────────────────────────────────
